# ══════════════════════════════════════════════════════════════
# RENDER.COM ORTAM DEĞİŞKENLERİ — REFERANS
# Bu dosyayı Render'a yüklemeyin. Render'ın kendi paneli var:
# Dashboard → Web Service → Environment → Add Environment Variable
# Buradaki her satırı orada tek tek girin.
# ══════════════════════════════════════════════════════════════

# --- Zorunlu ---
DATABASE_URL=                     # Render Postgres kullanıyorsanız "Internal Database URL"yi buraya
JWT_SECRET=                       # GÜÇLÜ, rastgele bir değer üretin (örn: openssl rand -hex 32) — asla tahmin edilebilir bir şey yazmayın
APP_URL=                          # https://sizin-servisiniz.onrender.com (veya kendi alan adınız)
ALLOWED_ORIGINS=                  # APP_URL ile birebir aynı, virgülle birden fazla origin eklenebilir
PORT=10000                        # Render kendi PORT değerini otomatik enjekte eder; bu satırı Render panelinde AYARLAMAYIN, boş bırakın
NODE_ENV=production

# --- Güvenlik için ZORUNLU (kod içinde varsayılan bir değeri var — mutlaka override edin) ---
ADMIN_SECRET=                     # GÜÇLÜ, rastgele bir değer. BOŞ BIRAKMAYIN — server.js'te varsayılan bir değere düşüyor, production'da bu asla kullanılmamalı.

# --- Opsiyonel (kullanıyorsanız doldurun) ---
GOOGLE_CLIENT_ID=
RESEND_API_KEY=
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_ENV=production             # Canlıya geçtiğinizde "sandbox" değil "production" olmalı
USDA_API_KEY=

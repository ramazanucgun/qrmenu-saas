# ══════════════════════════════════════════════════════════════
# LOCALHOST GELİŞTİRME AYARLARI
# Bu dosya .gitignore içinde — repoya asla commit edilmez.
# Detaylı kurulum adımları için LOCALHOST_KURULUM.md dosyasına bakın.
# ══════════════════════════════════════════════════════════════

# --- Zorunlu ---
# Aşağıya kendi Postgres bağlantı adresinizi yazın.
# (server.js SSL bekliyor — bkz. LOCALHOST_KURULUM.md "Veritabanı" bölümü)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cafemenu

JWT_SECRET=local-dev-secret-degistirin-bu-sadece-test-icin
APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
PORT=3000
NODE_ENV=development

# --- Opsiyonel (boş bırakılırsa ilgili özellik pasif çalışır, sunucu yine de açılır) ---
GOOGLE_CLIENT_ID=
RESEND_API_KEY=
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_ENV=sandbox
ADMIN_SECRET=local-dev-admin-secret
USDA_API_KEY=
